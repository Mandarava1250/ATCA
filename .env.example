MEDIA_DB_NAME=Media_3D
MEDIA_DB_USER=ATCA
MEDIA_DB_PASSWORD=ATCA@123.-
MEDIA_DB_ENCRYPT=false
MEDIA_DB_TRUST_SERVER_CERTIFICATE=true

# CORS配置
CORS_ORIGIN=https://your-domain.com

# AI Provider API Keys（根据实际配置的Provider填写）
OPENAI_API_KEY=
CLAUDE_API_KEY=
KIMI_API_KEY=
QWEN_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
