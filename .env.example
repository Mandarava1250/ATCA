# 生产环境变量模板
# 复制为 .env 并根据实际情况修改

NODE_ENV=production
PORT=3000
API_PREFIX=/api/v1

# JWT配置（生产环境务必使用强密钥）
JWT_SECRET=change-this-to-a-strong-secret-key-in-production
JWT_REFRESH_SECRET=change-this-to-another-strong-secret-key-in-production

# 用户数据库
USER_DB_HOST=sqlserver
USER_DB_PORT=1433
USER_DB_NAME=ATCA_User
USER_DB_USER=
USER_DB_PASSWORD=
USER_DB_ENCRYPT=false
USER_DB_TRUST_SERVER_CERTIFICATE=true

# 建筑数据库
ARCH_DB_HOST=sqlserver
ARCH_DB_PORT=1433
ARCH_DB_NAME=Architecture
ARCH_DB_USER=
ARCH_DB_PASSWORD=
ARCH_DB_ENCRYPT=false
ARCH_DB_TRUST_SERVER_CERTIFICATE=true

# 竞赛数据库
COMP_DB_HOST=sqlserver
COMP_DB_PORT=1433
COMP_DB_NAME=Competition
COMP_DB_USER=
COMP_DB_PASSWORD=
COMP_DB_ENCRYPT=false
COMP_DB_TRUST_SERVER_CERTIFICATE=true

# 活动数据库
ACT_DB_HOST=sqlserver
ACT_DB_PORT=1433
ACT_DB_NAME=Activity
ACT_DB_USER=
ACT_DB_PASSWORD=
ACT_DB_ENCRYPT=false
ACT_DB_TRUST_SERVER_CERTIFICATE=true

# 3D媒体数据库
MEDIA_DB_HOST=sqlserver
MEDIA_DB_PORT=1433
MEDIA_DB_NAME=Media_3D
MEDIA_DB_USER=
MEDIA_DB_PASSWORD=
MEDIA_DB_ENCRYPT=false
MEDIA_DB_TRUST_SERVER_CERTIFICATE=true

# 数据库连接池配置（可选，有默认值）
# DB_POOL_MAX=3
# DB_POOL_MIN=0
# DB_POOL_IDLE_TIMEOUT=15000
# DB_CONNECTION_TIMEOUT=10000
# DB_REQUEST_TIMEOUT=20000

# Redis配置（可选，认证黑名单存储）
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# CORS配置
CORS_ORIGIN=https://atca.xin

# AI Provider API Keys（根据实际配置的Provider填写）
OPENAI_API_KEY=
CLAUDE_API_KEY=
KIMI_API_KEY=
QWEN_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
