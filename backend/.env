# 华夏营造 - 环境变量配置

# 服务器配置
PORT=3000
NODE_ENV=development
API_PREFIX=/api/v1

# 默认启用Mock模式（无需数据库）
MOCK_MODE=true

# JWT 密钥配置
JWT_SECRET=atca-secret-key-for-jwt-signing-2024
JWT_REFRESH_SECRET=atca-refresh-secret-key-for-jwt-signing-2024

# 数据库配置（开发环境使用Mock模式）
DB_USER_HOST=localhost
DB_USER_PORT=1433
DB_USER_NAME=atca_user
DB_USER_USER=sa
DB_USER_PASSWORD=your_password

DB_ARCHITECTURE_HOST=localhost
DB_ARCHITECTURE_PORT=1433
DB_ARCHITECTURE_NAME=atca_architecture
DB_ARCHITECTURE_USER=sa
DB_ARCHITECTURE_PASSWORD=your_password

DB_QUIZ_HOST=localhost
DB_QUIZ_PORT=1433
DB_QUIZ_NAME=atca_quiz
DB_QUIZ_USER=sa
DB_QUIZ_PASSWORD=your_password

DB_ACTIVITY_HOST=localhost
DB_ACTIVITY_PORT=1433
DB_ACTIVITY_NAME=atca_activity
DB_ACTIVITY_USER=sa
DB_ACTIVITY_PASSWORD=your_password

DB_MEDIA3D_HOST=localhost
DB_MEDIA3D_PORT=1433
DB_MEDIA3D_NAME=atca_media3d
DB_MEDIA3D_USER=sa
DB_MEDIA3D_PASSWORD=your_password

# Redis 配置（可选）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# CORS 配置
CORS_ORIGIN=http://localhost:5173,http://localhost:8080

# 文件上传配置
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=52428800

# 日志配置
LOG_LEVEL=info

# 性能配置
ENABLE_PERFORMANCE_MONITOR=true
ENABLE_KEEP_ALIVE=true
