{
  "name": "atca-backend",
  "version": "1.0.0",
  "description": "筑见山河 - 中国传统建筑成就网站后端",
  "main": "dist/src/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc --listEmittedFiles --diagnostics",
    "postbuild": "xcopy src\\config\\DB\\*.sql dist\\src\\config\\DB\\ /Y 2>nul || true",
    "build:clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc --listEmittedFiles --diagnostics",
    "build:verbose": "tsc --listEmittedFiles --extendedDiagnostics",
    "start": "node dist/src/main.js",
    "check": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "test:load": "tsx src/tests/performance/loadTest.ts",
    "test:load:local": "tsx src/tests/performance/loadTest.ts local",
    "test:load:production": "tsx src/tests/performance/loadTest.ts production",
    "test:load:stress": "tsx src/tests/performance/loadTest.ts stress"
  },
  "dependencies": {
    "@types/bcrypt": "^6.0.0",
    "axios": "^1.7.2",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "etag": "^1.8.1",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "mssql": "^11.0.0",
    "multer": "^1.4.5-lts.1",
    "reflect-metadata": "^0.2.2",
    "socket.io": "^4.8.3",
    "uuid": "^9.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/etag": "^1.8.4",
    "@types/express": "^4.17.21",
    "@types/ioredis": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/mssql": "^9.1.5",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.19.43",
    "@types/supertest": "^7.2.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^9.0.8",
    "jest": "^30.4.2",
    "supertest": "^7.2.2",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "ts-jest": "^29.4.11",
    "tsx": "^4.11.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
